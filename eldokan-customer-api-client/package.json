{
  "name": "@eldokan/customer-api-client",
  "version": "0.8.1",
  "private": true,
  "description": "Official framework-agnostic TypeScript client for ElDokan Customer API Contract v1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "START-HERE.md",
    "CHANGELOG.md",
    "MAHMOUD-FRONTEND-HANDOFF.md",
    "REVIEWS.md",
    "COMMERCE.md",
    "STORIES.md"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "node scripts/generate-types.mjs && tsc --noEmit && tsc && node --test tests/*.test.mjs && node scripts/verify-package.mjs",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
