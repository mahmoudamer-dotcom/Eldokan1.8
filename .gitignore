# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates
/artifacts/.npm-cache/
/artifacts/php-syntax/

# Third-party plugin bundles (paid licenses); never commit.
Test.zip

# Only the running storefront and the live WordPress plugin sources are kept in the repo.
# Build outputs, old plugin variants and third-party references stay local.
/artifacts/
/wordpress-reference/
/wordpress-plugin-source/
/wordpress/eldokan-checkout-options/
/wordpress/eldokan-checkout-payment-diagnostics/
/wordpress/eldokan-checkout-setup/
/wordpress/eldokan-customer-api-cancellation/
/wordpress/eldokan-customer-api-fixed/
/wordpress/eldokan-customer-api-installments/
/wordpress/eldokan-customer-api-installments-recovery/
/wordpress/eldokan-customer-api-installments-safe/
/wordpress/eldokan-customer-api-options/
/wordpress/eldokan-stories/
/wordpress/eldokan-product-seller/

# Documentation stays local; the repo holds code only.
*.md
